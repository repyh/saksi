BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Explicit browser origins allowed to call APIs across origins. Never use `*` with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Supabase runtime connection: use Supavisor session mode (port 5432) for a persistent server.
# Use the exact host, user, and password shown by Supabase Dashboard > Connect.
DATABASE_URL="postgresql://prisma.<PROJECT_REF>:<DB_PASSWORD>@<POOLER_HOST_FROM_CONNECT>:5432/postgres?sslmode=require"

# Prisma CLI/migrations: direct database endpoint (or Supavisor session mode on port 5432
# when the environment cannot reach the direct IPv6 endpoint). Never use transaction mode here.
DIRECT_URL="postgresql://prisma:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require"

# Maximum node-postgres connections per app process. For serverless deployments, start at 1.
DATABASE_POOL_MAX=5

# Server-only Supabase Storage credentials. Keep the report-evidence bucket private.
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SERVER_ONLY_SERVICE_ROLE_KEY>
SUPABASE_REPORTS_BUCKET=report-evidence

# Report photo retention in days. Photos are never public. Rejected/withdrawn/archived
# reports keep their photo for at most REPORT_MEDIA_REJECTED_RETENTION_DAYS.
REPORT_MEDIA_RETENTION_DAYS=365
REPORT_MEDIA_REJECTED_RETENTION_DAYS=180

# HMAC key for short-lived report-submission rate-limit fingerprints (defaults to BETTER_AUTH_SECRET).
REPORT_RATE_LIMIT_SECRET=<RANDOM_SECRET_AT_LEAST_32_CHARACTERS>
NEXT_PUBLIC_BASEMAP_URL=https://tiles.openfreemap.org/styles/positron
